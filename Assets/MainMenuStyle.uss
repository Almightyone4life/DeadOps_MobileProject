:root {
}

.header {
    font-size: 75px;
    color: rgb(3, 3, 3);
    -unity-font-definition: url("project://database/Assets/ShantellSans-VariableFont_BNCE,INFM,SPAC,wght.ttf?fileID=12800000&guid=70e50f0bf3ad7f24ba737c6213faf050&type=3#ShantellSans-VariableFont_BNCE,INFM,SPAC,wght");
    -unity-font-style: bold;
    margin-left: 479px;
}

.button {
    font-size: 40px;
    width: 220px;
    height: 75px;
    align-self: flex-start;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    margin-top: 50px;
    background-color: rgba(242, 0, 0, 0.122);
    margin-left: 740px;
    -unity-font-definition: url("project://database/Assets/ShantellSans-VariableFont_BNCE,INFM,SPAC,wght.ttf?fileID=12800000&guid=70e50f0bf3ad7f24ba737c6213faf050&type=3#ShantellSans-VariableFont_BNCE,INFM,SPAC,wght");
    transition-duration: 0.25s;
}

.button:hover {
    scale: 1.1 1.1;
    background-color: rgba(242, 0, 0, 0.741);
}

.header2 {
    align-items: center;
    justify-content: center;
    align-self: center;
    margin-left: -274px;
    margin-top: 11px;
    font-size: 60px;
    -unity-font-style: italic;
}
